<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.podcast-downloader</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/admin/Library/Application Support/Podsum/.venv/bin/python</string>
    <string>/Users/admin/Library/Application Support/Podsum/outputs/podcast_downloader.py</string>
    <string>--feeds-only</string>
    <string>--max-per-feed</string>
    <string>1</string>
  </array>

  <key>StartInterval</key>
  <integer>21600</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/admin/Library/Logs/podcast-downloader.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/admin/Library/Logs/podcast-downloader.err.log</string>
</dict>
</plist>
