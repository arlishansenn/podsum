# Copy this file to:
# ~/Library/Application Support/Podsum/.env
#
# Do not commit the real .env file.

PODSUM_EMAIL_IMAP_HOST=imap.example.com
PODSUM_EMAIL_IMAP_PORT=993
PODSUM_EMAIL_IMAP_USER=user@example.com
PODSUM_EMAIL_IMAP_PASS=replace-with-app-password
PODSUM_EMAIL_IMAP_MAILBOX=INBOX
PODSUM_EMAIL_IMAP_TLS_VERIFY=true

# 投递目标，必填。没有默认值：不配置时投递会明确报错，不会静默投到某个频道。
# 形如 discord:<channel-id> 或 feishu:<chat-id>。
PODSUM_TARGET=discord:replace-with-channel-id

# --email-delivery email 时的 SMTP 直发配置。缺省值：
#   host 从 IMAP host 或邮箱域名推断，port 465，走 SSL，校验证书，超时 30s
#   from / to 缺省回落到 SMTP 用户，再回落到 IMAP 用户
# 收件人可用逗号、分号或空格分隔多个。
PODSUM_EMAIL_SMTP_HOST=
PODSUM_EMAIL_SMTP_PORT=465
PODSUM_EMAIL_SMTP_USER=
PODSUM_EMAIL_SMTP_PASS=
PODSUM_EMAIL_SMTP_FROM=
PODSUM_EMAIL_SMTP_TO=
PODSUM_EMAIL_SMTP_STARTTLS=false
PODSUM_EMAIL_SMTP_SSL=true
PODSUM_EMAIL_SMTP_TLS_VERIFY=true
PODSUM_EMAIL_SMTP_TIMEOUT=30
