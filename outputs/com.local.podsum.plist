<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.podsum</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PODSUM_HOME__/.venv/bin/python</string>
    <string>__PODSUM_HOME__/outputs/podsum.py</string>
    <string>run-once</string>
    <string>--cleanup</string>
    <string>--audio-retention-days</string>
    <string>14</string>
    <string>--transcript-retention-days</string>
    <string>90</string>
    <string>--untranscribed-audio-retention-days</string>
    <string>30</string>
    <string>--bundle-retention-days</string>
    <string>90</string>
    <!-- 读取真实邮箱的确认刻意留在这里，不移进 .env：它的价值就是每个调用点
         都得显式写一遍，进了配置文件就变成一次设置、永久生效。 -->
    <string>--email-allow-imap-read</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/podsum.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/podsum.err.log</string>
</dict>
</plist>
